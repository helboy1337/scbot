{
  "name": "sc-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test:refinery-ocr": "tsx scripts/test-refinery-ocr.ts",
    "github:ensure-label": "tsx scripts/ensure-auto-agent-label.ts"
  },
  "dependencies": {
    "@octokit/request-error": "^7.0.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "prisma": "^6.19.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
